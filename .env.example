# Copy to .env only if future integration needs settings.
# Bootstrap uses localhost commands and Vite proxy; .env is not loaded yet.
# No external API keys, database, or production credentials are required.
ORBITTRACE_HOST=127.0.0.1
ORBITTRACE_PORT=8000
# Runtime storage is server-controlled (future T09); never client supplied.
ORBITTRACE_ARTIFACT_ROOT=artifacts/jobs
